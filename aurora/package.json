{
  "name": "aurora",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply aurora-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply aurora-db --local",
    "backup": "wrangler d1 export aurora-db --remote --output respaldo-aurora.sql",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  }
}
